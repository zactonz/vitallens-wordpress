# Not part of the plugin users install.
#
# .wporg holds the screenshots the readme declares. On WordPress.org those go in
# the repository's own assets/ directory, which is served separately and is NOT
# this plugin's assets/ folder - that one holds admin.css and admin.js and must
# ship.
.wporg
.distignore
dist
docs

# Development gates, not plugin code. tools/lint-nouns.php fails any string
# that renders a per-device row count with the word "page" - the defect 1.0.1
# fixed in six places.
tools

# Repository landing page, not plugin documentation. WordPress.org reads
# readme.txt, and this file points at images under docs/ which do not ship.
README.md
.git
.gitignore

# macOS writes these into any folder someone opens in Finder, and Plugin Check
# refuses a package containing a hidden file. Excluded here rather than left to
# whoever runs the build to remember.
.DS_Store
